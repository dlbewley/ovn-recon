[
  {
    "apiVersion": "k8s.ovn.org/v1",
    "kind": "ClusterUserDefinedNetwork",
    "metadata": {
      "name": "example-p-cudn",
      "labels": {
        "network/cudn-p-10-1-2-0": ""
      }
