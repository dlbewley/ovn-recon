            "10.1.2.0/24"
          ]
        },
        "topology": "Layer2"
      }
    },
    "status": {
      "conditions": [
        {
          "type": "NetworkCreated",
          "status": "True",
          "reason": "NetworkAttachmentDefinitionCreated",
